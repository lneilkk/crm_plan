# 치과 CRM 환경변수 목록.
#
# 이 파일에는 비밀값을 적지 않는다(절대 규칙 2). 실제 값은 .env(git 제외)에만 둔다.
# `npm run setup:env`(또는 `npm run db:up`)가 이 파일을 복사해 .env를 만들고
# 비어 있는 비밀값을 무작위로 채운다. 이미 있는 .env는 건드리지 않는다.
#
# 값에는 따옴표·공백·주석을 붙이지 않는다(docker-compose와 dotenv가 같은 값을 읽게 하기 위해).

# --- 로컬 DB (docker-compose.yml) ---

# Docker Compose 프로젝트 이름. 컨테이너 이름 앞에 붙어 같은 서버의 다른 프로젝트와 구분된다.
COMPOSE_PROJECT_NAME=crm_plan

# PostgreSQL 접속 계정 이름.
POSTGRES_USER=crm

# PostgreSQL 데이터베이스 이름.
POSTGRES_DB=crm

# 이 PC에서 DB에 접속할 포트. 127.0.0.1에만 열린다(5432는 다른 서비스가 쓰고 있어 피했다).
# .env에서 바꾸면 DATABASE_URL의 포트도 직접 같이 고친다.
POSTGRES_PORT=54329

# PostgreSQL 비밀번호. setup 스크립트가 무작위로 만든다.
# DB를 처음 만들 때만 적용되므로, 나중에 바꾸려면 .data/postgres를 지우고 다시 띄운다.
# 이때 DATABASE_URL의 비밀번호도 직접 같이 고친다.
POSTGRES_PASSWORD=

# 앱(Prisma)과 스크립트가 쓰는 DB 접속 주소. setup 스크립트가 .env를 처음 만들 때 위 값들로 한 번 조립한다.
# 그 뒤에는 자동으로 바뀌지 않는다. 위의 계정·비밀번호·포트·DB 이름을 바꾸면 이 값도 직접 고친다.
# 형식: postgresql://USER:PASSWORD@127.0.0.1:PORT/DB
DATABASE_URL=

# --- 개인정보 암호화 (기획서 10장) ---

# 전화번호·생년월일 컬럼 암호화 키(AES-256-GCM). 무작위 32바이트를 base64로 적는다.
# 잃어버리면 저장된 값을 복호화할 수 없다.
PII_ENC_KEY=

# 전화번호 검색용 해시 키(HMAC). 무작위 32바이트를 base64로 적는다. 암호화 키와 다른 값이어야 한다.
PII_HMAC_KEY=

# --- 앱 실행 (운영 Docker Compose, docs/DEPLOY.md) ---

# 앱이 열리는 호스트 포트(127.0.0.1에만 열림). 비우면 3100. 개발 서버(npm run dev)는 이 값과 상관없이 3100을 쓴다.
APP_PORT=3100

# 앱 앞단 프록시 수. 감사 로그의 접속 IP를 X-Forwarded-For에서 몇 번째 값으로 읽을지 정한다.
# 개발(프록시 없음)은 0, 운영에서 Caddy 1대 뒤에 두면 1. 0이면 감사 로그의 IP가 비어 있다.
TRUSTED_PROXY_HOPS=0

# --- 개발·프로토타입 전용 ---

# 시드로 만드는 역할별 테스트 계정의 비밀번호. setup 스크립트가 무작위로 만든다.
SEED_STAFF_PASSWORD=

# 가짜 데이터 생성·시드 스크립트 실행 허용. 개발·프로토타입 환경에서만 true로 둔다.
# 실제 운영 환경에는 이 변수를 절대 설정하지 않는다.
FAKE_DATA_ALLOWED=true

# --- setup 스크립트가 채우는 값 ---

# DB 컨테이너를 실행할 사용자·그룹 ID(현재 로그인한 개발자).
# .data/postgres의 파일 소유자가 개발자가 되어 sudo 없이 지울 수 있다.
HOST_UID=
HOST_GID=
